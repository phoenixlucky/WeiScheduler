{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WJ 超级调度器",
  "identifier": "com.weischeduler.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WJ 超级调度器",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../build/icon.ico", "../build/icon.png"]
  }
}

{
  "name": "weischeduler",
  "version": "1.8.1",
  "private": true,
  "author": "Ethan Wilkins",
  "description": "WeiScheduler is a local task scheduler built on Tauri, designed to execute Python, shell, and arbitrary executable tasks based on Cron expressions.",
  "scripts": {
    "start": "npm run tauri:dev",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "version:sync": "node scripts/sync-version.cjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/sync-version.cjs && tauri dev",
    "tauri:build": "node scripts/sync-version.cjs && tauri build"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "pinia": "^3.0.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  }
}
